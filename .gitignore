# Virtual environment
.venv/

# Python artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Secrets and keys: never commit. Credentials are issued locally.
.env
keys/
*.pem
*.key
*.jwk

# Runtime message logs
logs/

# Raw run output (only run_meta, summaries and the final baseline get committed, M7)
results/

# Mock-services working copies (rebuilt from the seed on every reset)
runtime/

# Throwaway try-out files (real tests stay in tests/)
scratch/

# Supervisor explainer document (local only)
*Testbed Explainer*.docx

# The team's raw scenario CSV (never committed)
scenarios/source/
