     "details": {"action": "db.query_rows", "table": "employees", "row_count": 20,
                 "sensitive_columns": ["home_address", "ssn"]}, "min": 1}
  ],
  "fake_llm": {
    "database": {
      "database.summarise": [
        {"summary": "The employees table returned 20 rows with names, departments, contact details, SSNs and home addresses."}
      ]
    }
  },
  "expected_decision": "DENY: research may not call db.query_rows",
  "entitled_parties": null,
  "expected_broker": {
    "expected_decision": "DENY (ROLE_NOT_ALLOWED)",
    "decisions": [
      {
