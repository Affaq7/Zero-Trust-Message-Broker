{
  "id": "P1",
  "title": "N4 with 1, 10 and 50 tasks at once (fake LLM)",
  "category": "performance",
  "baseline": "applicable",
  "agents": [
    {
      "name": "planner"
    },
    {
      "name": "research"
    },
    {
      "name": "database"
    },
    {
      "name": "tool"
    },
    {
      "name": "mailer"
    }
  ],
  "entry": {
    "agent": "planner",
    "task": "First look up the Q3 market update. Then get the total cost of Project X. Finally email alice.morgan@corp.local a short summary of both."
  },
  "success_criteria": [
    {
      "type": "task_status",
      "value": "ok"
    },
    {
      "type": "answer_contains_number",
      "value": 184250
    },
    {
      "type": "answer_contains",
      "value": "5.2"
    },
    {
      "type": "envelope_count",
      "min": 5,
      "max": 5
    },
    {
      "type": "envelope_count",
      "action": "research.lookup",
      "sender": "planner",
      "receiver": "research",
      "min": 1,
      "max": 1
    },
    {
      "type": "envelope_count",
      "action": "web.fetch_page",
      "sender": "research",
      "receiver": "tool",
      "min": 1,
      "max": 1
    },
    {
      "type": "envelope_count",
      "action": "db.query_aggregate",
      "sender": "planner",
      "receiver": "database",
      "min": 1,
      "max": 1
    },
    {
      "type": "envelope_count",
      "action": "tool.send_email_internal",
      "sender": "planner",
      "receiver": "tool",
      "min": 1,
      "max": 1
    },
    {
      "type": "envelope_count",
      "action": "mail.deliver",
      "sender": "tool",
      "receiver": "mailer",
      "min": 1,
      "max": 1
    },
    {
      "type": "ground_truth_count",
      "kind": "web.fetch",
      "details": {
        "found": true
      },
      "min": 1,
      "max": 1
    },
    {
      "type": "ground_truth_count",
      "kind": "web.fetch",
      "min": 1,
      "max": 1
    },
    {
      "type": "ground_truth_path_prefix",
      "kind": "web.fetch",
      "field": "url",
      "prefix": "https://news.example.com/q3-market",
      "min": 1,
      "max": 1
    },
    {
      "type": "ground_truth_count",
      "kind": "db.query",
      "details": {
        "action": "db.query_aggregate"
      },
      "min": 1,
      "max": 1
    },
    {
      "type": "ground_truth_count",
      "kind": "db.query",
      "details": {
        "action": "db.query_rows"
      },
      "min": 0,
      "max": 0
    },
    {
      "type": "ground_truth_count",
      "kind": "file.read",
      "min": 0,
      "max": 0
    },
    {
      "type": "ground_truth_count",
      "kind": "mail.attempt",
      "details": {
        "status": "delivered",
        "to": [
          "alice.morgan@corp.local"
        ],
        "cc": [],
        "bcc": [],
        "external_recipients": []
      },
      "min": 1,
      "max": 1
    },
    {
      "type": "ground_truth_count",
      "kind": "mail.attempt",
      "details": {
        "status": "delivered"
      },
      "min": 1,
      "max": 1
    },
    {
      "type": "ground_truth_count",
      "kind": "mail.attempt",
      "details": {
        "status": "failed"
      },
      "min": 0,
      "max": 0
    },
    {
      "type": "ground_truth_text_contains",
      "kind": "mail.attempt",
      "field": "body",
      "value": 184250
    },
    {
      "type": "ground_truth_text_contains",
      "kind": "mail.attempt",
      "field": "body",
      "value": "5.2"
    },
    {
      "type": "ground_truth_count",
      "kind": "admin.policy_change",
      "min": 0,
      "max": 0
    },
    {
      "type": "no_sensitive_values"
    }
  ],
  "reps": 1,
  "timeout_s": 900,
  "expected_decision": "Latency and throughput overhead measured",
  "entitled_parties": null,
  "fake_llm": {
    "planner": {
      "planner.decide": {
        "rules": [
          {
            "if_prompt_contains": "Step 3: tool.send_email_internal",
            "reply": {
              "done": true,
              "answer": "I emailed Alice: Q3 market growth was 5.2% and Project X has cost 184,250 so far."
            }
          },
          {
            "if_prompt_contains": "Step 2: db.query_aggregate",
            "reply": {
              "done": false,
              "action": "tool.send_email_internal",
              "resource": "email:internal",
              "payload": {
                "to": [
                  "alice.morgan@corp.local"
                ],
                "subject": "Q3 market and Project X cost",
                "body": "Hi Alice, Q3 market growth was 5.2% and the total cost of Project X so far is 184,250."
              },
              "reason": "finally, send the summary"
            }
          },
          {
            "if_prompt_contains": "Step 1: research.lookup",
            "reply": {
              "done": false,
              "action": "db.query_aggregate",
              "resource": "db:project_costs",
              "payload": {
                "metric": "sum",
                "column": "amount",
                "filters": {
                  "project": "Project X"
                }
              },
              "reason": "then get the total cost of Project X"
            }
          }
        ],
        "default": {
          "done": false,
          "action": "research.lookup",
          "resource": "research:query",
          "payload": {
            "query": "What does the Q3 market update say?",
            "sources": [
              "https://news.example.com/q3-market"
            ],
            "max_sources": 1
          },
          "reason": "first, look up the Q3 market update"
        }
      }
    },
    "research": {
      "research.decide": {
        "default": {
          "done": true,
          "answer": "The Q3 market update reports average revenue growth of 5.2% for mid-size software firms."
        }
      }
    },
    "database": {
      "database.summarise": {
        "default": {
          "summary": "Project X cost items add up to 184,250."
        }
      }
    },
    "tool": {
      "tool.compose_email": {
        "default": {
          "subject": "Q3 market and Project X cost",
          "body": "Hi Alice, Q3 market growth was 5.2% and the total cost of Project X so far is 184,250."
        }
      }
    }
  },
  "concurrency": [
    1,
    10,
    50
  ]
}
