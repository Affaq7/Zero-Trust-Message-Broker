# Copy to .env and adjust. No secrets belong in this file.

# Operator-set only. Agents must never read this from a message.
# direct = agents call each other straight (baseline, no broker)
# broker = traffic goes through the broker (not implemented yet)
MODE=direct

# Which agent this wrapper instance runs (dummy, planner, research, database, tool, malicious)
AGENT_NAME=dummy

# Optional: which agent code runs under AGENT_NAME (default: same as AGENT_NAME).
# The runner sets AGENT_IMPL=malicious to start an impostor under a victim's name.
# AGENT_IMPL=
# Role in this process's stub tokens (default: AGENT_NAME if it is a catalog role).
# AGENT_ROLE=

# Where the other agents' wrappers listen (name=url, comma-separated).
# Operator-set only; send_message() never takes URLs from a message.
AGENT_URLS=dummy=http://127.0.0.1:8001

# Folder for the JSONL message log (default: logs/ in the repo root, gitignored)
# LOG_DIR=logs

# Ollama endpoint (used by the real LLM agents in a later milestone)
LLM_BASE_URL=http://localhost:11434
